# Runtime environment for medusa-server and medusa-worker on the VPS. Copy to
# backend.env (chmod 600). Never commit it. Both processes read this one file,
# so they always agree on secrets and keys.
#
# Set in compose.yaml instead, not here: REDIS_URL (the local Redis container),
# MEDUSA_WORKER_MODE, NODE_OPTIONS, SENTRY_RELEASE. The image sets
# NODE_ENV=production and ADMIN_DISABLED=true.
#
# Replace example.com throughout with this deployment's DOMAIN. Every variable
# is described in apps/backend/.env.template.

# --- Database (Neon) ---------------------------------------------------------
# The DIRECT connection string (host without "-pooler"). Change Neon's
# sslmode=require to verify-full: pg treats require as verify-full today but
# warns it will stop verifying the certificate in a future release.
# See docs/deployment.md for why not the pooled endpoint.
DATABASE_URL=postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/store?sslmode=verify-full

# --- Public URLs and CORS ----------------------------------------------------
# The storefront calls Medusa server-to-server, so STORE_CORS is only for any
# future browser client. The dashboard at admin.<domain> calls api.<domain>
# from the browser, which is what ADMIN_CORS and AUTH_CORS allow.
STORE_CORS=https://example.com
ADMIN_CORS=https://admin.example.com
AUTH_CORS=https://admin.example.com
# Links in emails: order confirmations, invites, password resets.
STOREFRONT_URL=https://example.com
ADMIN_URL=https://admin.example.com
PAYMENT_CALLBACK_URL=https://example.com/checkout/callback

# --- Secrets (generate each with: openssl rand -hex 32) ----------------------
# Startup refuses JWT_SECRET or COOKIE_SECRET shorter than 32 characters.
JWT_SECRET=
COOKIE_SECRET=
AUTH_MFA_ENCRYPTION_KEY=
# Exactly 64 hex characters. Encrypts queued email snapshots: keep it for as
# long as any undelivered email may exist, and never rotate it casually.
EMAIL_DELIVERY_ENCRYPTION_KEY=

# --- First deploy only -------------------------------------------------------
# The first deploy's seed step (db:migrate:scripts) creates this Super Admin.
# Remove both lines after it has run; the seed never runs twice.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Store -------------------------------------------------------------------
STORE_NAME=Youjaymharah
SUPPORT_EMAIL=support@example.com
# Optional. Keys every Redis entry, only needed if environments share a Redis.
REDIS_PREFIX=

# --- Payments ----------------------------------------------------------------
CREDO_MODE=live
CREDO_PUBLIC_KEY=
CREDO_SECRET_KEY=
CREDO_WEBHOOK_TOKEN=
CREDO_BUSINESS_CODE=
PAYSTACK_SECRET_KEY=

# --- Files (Cloudflare R2 or any S3-compatible store) ------------------------
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_REGION=auto
# Public base URL for uploaded files, ideally a custom domain.
S3_FILE_URL=https://files.example.com

# --- Email (Resend) ----------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=orders@example.com
# Known templates use this sender's domain with onboarding@ (verification),
# accounts@ (password resets/invites), orders@ (order lifecycle), or hello@
# (newsletter, product alerts, cart reminders). Unknown templates use it as-is.
# onboarding@resend.dev stays unchanged for testing.
# Optional group overrides: full sender, e.g. "The YJ Edit <hello@example.com>".
# Use a verified sending domain. Blank values use the defaults above.
RESEND_FROM_ONBOARDING_EMAIL=
RESEND_FROM_ACCOUNTS_EMAIL=
RESEND_FROM_ORDERS_EMAIL=
RESEND_FROM_MARKETING_EMAIL=
# Signing secret of the https://api.example.com/webhooks/resend endpoint.
RESEND_WEBHOOK_SECRET=

# --- Optional ----------------------------------------------------------------
# Customer Google sign-in: all three or none.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://example.com/api/auth/google/callback
# Leave empty: the storefront has no /api/revalidate route yet, so setting it
# only produces failed calls in the log.
STOREFRONT_REVALIDATE_SECRET=
SEARCH_TRENDING_TERMS=
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
