{
  "name": "@youjaymharah/docs",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.12.0",
  "engines": {
    "node": "^22.12.0"
  },
  "scripts": {
    "sync": "node scripts/sync-reference.mjs",
    "dev": "pnpm run sync && vitepress dev --host 127.0.0.1 --port 8001",
    "build": "pnpm run sync && vitepress build",
    "start": "node scripts/preview.mjs",
    "lint": "node --check scripts/sync-reference.mjs && node --check scripts/sync-brand.mjs && node --check scripts/branding-proxy.mjs && node --check scripts/preview.mjs && node scripts/check-content.mjs",
    "test": "node --test scripts/*.test.mjs"
  },
  "devDependencies": {
    "sirv": "^3.0.2",
    "vitepress": "1.6.4",
    "vue": "3.5.44"
  }
}
