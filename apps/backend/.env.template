STORE_CORS=http://localhost:8000,https://docs.medusajs.com
ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
AUTH_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
# Development-only placeholders. Generate separate random secrets of at least
# 32 characters for production; startup rejects short secrets.
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
AUTH_MFA_ENCRYPTION_KEY=
DATABASE_URL=
DB_NAME=medusa-backend

# First admin user, created by the initial-data-seed script on db:migrate.
# Leave empty to skip seeding (create manually with `medusa user` instead).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Payments
PAYMENT_CALLBACK_URL=http://localhost:8000/checkout/callback
CREDO_MODE=test
CREDO_PUBLIC_KEY=
CREDO_SECRET_KEY=
CREDO_WEBHOOK_TOKEN=
CREDO_BUSINESS_CODE=
PAYSTACK_SECRET_KEY=

# Cloudflare R2 (S3-compatible). From the Cloudflare dashboard:
#   S3_ENDPOINT  https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#                NOTE: do NOT append the bucket name — the SDK adds it, and
#                objects otherwise upload one level deep and 404 on S3_FILE_URL.
#   S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY  R2 > Manage R2 API Tokens (secret shown once)
#   S3_BUCKET    the bucket name you chose
#   S3_FILE_URL  public base URL: the bucket's pub-<hash>.r2.dev address, or a
#                custom domain. Prefer a custom domain in production; r2.dev is
#                rate-limited by Cloudflare.
#   S3_REGION    always "auto" for R2
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_FILE_URL=
S3_REGION=auto


# Google sign-in for customers. All three are required together: set them and
# the provider switches on, leave any blank and the store stays email/password
# only. From Google Cloud Console > APIs & Services > Credentials > OAuth
# client ID (type: Web application).
#   GOOGLE_CALLBACK_URL  the storefront page Google returns the customer to,
#                        e.g. https://<storefront>/auth/google/callback (locally
#                        http://localhost:8000/auth/google/callback). Register
#                        this exact URL as an Authorised redirect URI in Google,
#                        and make sure the storefront origin is in AUTH_CORS.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# Notifications
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Known templates use this sender's domain with onboarding@ (verification),
# accounts@ (password resets/invites), orders@ (order lifecycle), or hello@
# (newsletter, product alerts, cart reminders). Unknown templates use it as-is.
# onboarding@resend.dev stays unchanged for testing.
# Optional group overrides: full sender, e.g. "The YJ Edit <hello@example.com>".
# Use a verified sending domain. Blank values use the defaults above.
RESEND_FROM_ONBOARDING_EMAIL=
RESEND_FROM_ACCOUNTS_EMAIL=
RESEND_FROM_ORDERS_EMAIL=
RESEND_FROM_MARKETING_EMAIL=
# Signing secret for POST /webhooks/resend (whsec_...), not the Resend API key.
# Enable contact.updated, email.bounced, email.complained, email.suppressed,
# and suppression.added on this endpoint in the Resend dashboard.
RESEND_WEBHOOK_SECRET=

# 32 random bytes encoded as 64 hex characters. Required for email snapshots.
# Keep identical on backend/workers; retain the key for pending deliveries/backups.
EMAIL_DELIVERY_ENCRYPTION_KEY=

# Initial reviewed public search phrases. Blank uses common clothing/fabric
# terms when the initial seed runs; [] explicitly seeds a disabled empty list.
# A saved or seeded database list takes precedence. Admin edits need no restart.
# Example: SEARCH_TRENDING_TERMS='["dresses","linen","bags"]'
SEARCH_TRENDING_TERMS=

# Email branding
STORE_NAME=Youjaymharah
SUPPORT_EMAIL=support@youjaymharah.com
STOREFRONT_URL=http://localhost:8000

# Base URL of the admin dashboard, used for invite and staff password-reset
# links. Include the path when this server serves the dashboard
# (http://localhost:9000/app locally); just the origin when it is deployed on
# its own host (https://admin.example.com in production).
ADMIN_URL=http://localhost:9000/app

# Set to true where the dashboard is deployed separately: this server then
# neither builds nor serves it. Production does this (the admin image serves it
# at admin.<domain>); locally leave it false and use /app.
ADMIN_DISABLED=false
# The dashboard's base path. Only the production admin image changes it (to /).
ADMIN_PATH=
# The API the dashboard calls, compiled into its bundle at build time.
MEDUSA_BACKEND_URL=http://localhost:9000

# Shared secret for refreshing the storefront's cache the moment Brand or
# Sharing & search settings are saved (POST <STOREFRONT_URL>/api/revalidate).
# Set the same value on the storefront. Leave empty to skip: the storefront
# then picks changes up within 5 minutes on its own.
STOREFRONT_REVALIDATE_SECRET=

# Required in production; optional locally.
# In production this is the Redis container next to Medusa, set by
# infra/compose.yaml (redis://redis:6379) rather than in backend.env. Locally,
# redis://localhost:6379 or any hosted Redis (rediss://default:<token>@<host>:6379).
# When set, Redis replaces the in-memory defaults for FIVE things: the event
# bus, the workflow engine, the cache, distributed locks, and admin sessions
# (sessions come from projectConfig.redisUrl -- without it admins are logged
# out by every deploy). Leave empty in local dev to run on the in-memory
# defaults; everything still works, just per-process and not across restarts.
#
# The instance must have eviction disabled (maxmemory-policy noeviction).
# BullMQ warns loudly otherwise, and an evicted key is a silently dropped job
# -- which here means an order confirmation email that never sends. A hosted
# Redis should be in the same region as the app: BullMQ holds blocking
# connections open, and cross-region latency shows up as ETIMEDOUT.
REDIS_URL=
# Optional. Namespaces every Medusa key, so several environments can share one
# Redis instance without colliding. Defaults to "youjaymharah:".
REDIS_PREFIX=

# Error tracking. Empty disables Sentry entirely, which is how development and
# CI run. SENTRY_RELEASE ties an error to a deploy; infra/compose.yaml sets it
# to the commit SHA. Tracing is off by default (0); raise it to sample transactions.
SENTRY_DSN=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0
