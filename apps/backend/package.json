{
  "name": "@youjaymharah/backend",
  "version": "0.0.1",
  "description": "A fashion store.",
  "author": "Brown Memoye <memoyebrown@gmail.com>",
  "license": "MIT",
  "keywords": [
    "sqlite",
    "postgres",
    "typescript",
    "ecommerce",
    "headless",
    "medusa"
  ],
  "scripts": {
    "test": "pnpm run test:unit",
    "build": "medusa build && if [ -d .medusa/server/public/admin ]; then mkdir -p public && cp -R .medusa/server/public/admin public/admin; fi",
    "start": "medusa start",
    "dev": "medusa develop",
    "lint": "medusa lint",
    "seed:demo": "medusa exec ./src/scripts/seed-demo-catalog.ts",
    "seed:announcements": "medusa exec ./src/scripts/seed-announcements.ts",
    "seed:search-vocabulary": "medusa exec ./src/scripts/seed-search-vocabulary.ts",
    "codegen": "ts-node scripts/generate-openapi.ts",
    "dev:email": "email dev --dir ./src/modules/resend/emails",
    "test:integration:http": "TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:http:batches": "node scripts/test-http-batches.mjs",
    "test:isolated": "node scripts/test-isolated.mjs",
    "test:integration:modules": "TEST_TYPE=integration:modules NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:unit": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit",
    "build:admin": "medusa build --admin-only"
  },
  "dependencies": {
    "@medusajs/admin-sdk": "2.20.1",
    "@medusajs/admin-shared": "2.20.1",
    "@medusajs/caching": "2.20.1",
    "@medusajs/cli": "2.20.1",
    "@medusajs/dashboard": "2.20.1",
    "@medusajs/draft-order": "2.20.1",
    "@medusajs/event-bus-redis": "2.20.1",
    "@medusajs/framework": "2.20.1",
    "@medusajs/icons": "2.20.1",
    "@medusajs/js-sdk": "2.20.1",
    "@medusajs/medusa": "2.20.1",
    "@medusajs/ui": "4.2.3",
    "@medusajs/workflow-engine-redis": "2.20.1",
    "@sentry/node": "^10.75.2",
    "@tanstack/react-query": "5.64.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-email": "^6.11.3",
    "react-i18next": "13.5.0",
    "react-router-dom": "7.18.2",
    "resend": "^6.25.0",
    "zod": "4.2.0"
  },
  "devDependencies": {
    "@medusajs/test-utils": "2.20.1",
    "@react-email/ui": "^6.11.3",
    "@swc/core": "^1.7.28",
    "@swc/jest": "^0.2.36",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.12.11",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.2.25",
    "jest": "^29.7.0",
    "prop-types": "^15.8.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "vite": "^7.3.6",
    "yalc": "^1.0.0-pre.53"
  },
  "engines": {
    "node": "^22.12.0"
  },
  "packageManager": "pnpm@11.12.0"
}
