# Copy to .env.local and fill in. Never commit real values.
#
# Production images take NEXT_PUBLIC_* and IMAGE_REMOTE_URLS as build
# arguments from the GitHub Environment (see .github/workflows/deploy.yml):
# they are compiled in and cannot be changed on the running container.

# Where the Next.js server reaches Medusa. The browser never calls this URL:
# Client Components go through this app's /api/medusa proxy instead.
# In production the container is given http://medusa-server:9000 (Docker
# network) at runtime, while the image build uses https://api.<domain>, since
# `next build` prerenders pages from a running Medusa.
MEDUSA_BACKEND_URL=http://localhost:9000

# The "Web Storefront" key from Settings > Publishable API Keys in the admin.
# Public by design: it identifies the storefront, it does not authenticate.
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=

# This storefront's public address, for absolute URLs in page metadata (link
# previews, canonical URLs). No trailing slash.
NEXT_PUBLIC_BASE_URL=http://localhost:8000

# Where next/image may load images from: comma-separated base URLs. Include the
# address uploads are served from (the backend's S3_FILE_URL, e.g. the R2
# bucket's https://pub-<hash>.r2.dev) and any other photo source the catalogue
# uses, e.g. https://images.unsplash.com for the demo products. Images from any
# other host fail to load. Fixed at build time: rebuild (or restart
# `next dev`) after changing it.
IMAGE_REMOTE_URLS=

# Shared with the backend, at least 32 random characters. Runtime only.
STOREFRONT_REVALIDATE_SECRET=

# Error tracking. The DSN is public by design and is needed in the browser, so
# it is NEXT_PUBLIC_. Empty disables Sentry. ORG, PROJECT and AUTH_TOKEN are
# build-time only, for uploading source maps; without the token the build still
# succeeds and stack traces stay minified.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
