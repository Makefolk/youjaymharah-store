{
  "name": "youjaymharah-store",
  "private": false,
  "packageManager": "pnpm@11.12.0",
  "engines": {
    "node": "^22.12.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "pnpm -r build",
    "start": "turbo start",
    "lint": "turbo lint",
    "test": "turbo test",
    "backend:seed": "turbo seed --filter=@youjaymharah/backend",
    "backend:dev": "turbo dev --filter=@youjaymharah/backend",
    "storefront:dev": "turbo dev --filter=@youjaymharah/storefront",
    "docs:dev": "turbo dev --filter=@youjaymharah/docs",
    "docs:build": "turbo build --filter=@youjaymharah/docs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@medusajs/eslint-plugin": "2.20.1",
    "eslint": "^9.39.4",
    "jiti": "^2.7.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.0.14"
  }
}
